# Copiar como .env junto a docker-compose.yml y ajustar.

# Carpeta del disco Isengard en OMV3 (la que se comparte como \\OPENMEDIAVAULT3\Isengard).
# Compruébala en OMV: Almacenamiento > Sistemas de archivos, o con `ls /srv` por SSH.
BIBLIOTECA_HOST=/srv/dev-disk-by-uuid-06bc004d-45d4-45ed-ad97-37a2bf089750/Isengard

# Catálogo y portadas (~3-4 GB con toda la biblioteca). Fuera de las carpetas RPG, Wargames, etc.
DATOS_HOST=/srv/dev-disk-by-uuid-06bc004d-45d4-45ed-ad97-37a2bf089750/Isengard/_Catalogo

# Usuario y grupo dueños de esos ficheros en OMV (por SSH: `id tu_usuario`). 100 = users.
PUID=1000
PGID=100

PUERTO=8090
RUTA_SMB=\\OPENMEDIAVAULT3\Isengard

# Indexador: procesos para portadas, núcleos máximos y horas entre pasadas.
PROCESOS=2
CPUS_INDEXADOR=2
INTERVALO_HORAS=6

# RPGGeek / BoardGameGeek: token de aplicación (gratis, uso no comercial).
# Se pide en https://boardgamegeek.com/applications. Vacío = no se consulta.
BGG_TOKEN=
# Minutos máximos de consultas a BGG por pasada (van a ~1 consulta cada 2,5 s).
GEEK_MINUTOS=240

# Clasificador: carpeta de entrada (relativa a la biblioteca) y confianza para mover sin preguntar
# (0 = todo pasa por la página Entrada; 0.9 acierta ~92% de las veces en las pruebas).
ENTRADA=_Inbox
CLASIFICADOR_AUTO=0.9

# Telegram (v3). Se piden en https://my.telegram.org -> API development tools.
# NO las subas a git ni las compartas: dan acceso a tu cuenta (este .env no se versiona).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Canales o grupos, separados por comas: ids (los da la orden `canales`) o @nombre.
TELEGRAM_CANALES=
TELEGRAM_EXTENSIONES=pdf,zip,rar,7z,cbz,cbr,epub
TELEGRAM_MAX_MB=4000
TELEGRAM_CADA_MIN=10
